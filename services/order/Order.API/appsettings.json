{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderDb": "Host=localhost;Port=5432;Database=order_db;Username=marketplace_user;Password=marketplace_pass"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "marketplace_user",
    "Password": "marketplace_pass",
    "VirtualHost": "marketplace",
    "ExchangeName": "marketplace.domain.events",
    "InventoryReservedQueueName": "order.inventory-reserved",
    "InventoryReservedRoutingKey": "inventory.reserved",
    "InventoryReservationFailedQueueName": "order.inventory-reservation-failed",
    "InventoryReservationFailedRoutingKey": "inventory.reservation.failed",
    "PaymentSucceededQueueName": "order.payment-succeeded",
    "PaymentSucceededRoutingKey": "payment.succeeded",
    "PaymentFailedQueueName": "order.payment-failed",
    "PaymentFailedRoutingKey": "payment.failed",
    "ShipmentCreatedQueueName": "order.shipment-created",
    "ShipmentCreatedRoutingKey": "shipment.created",
    "ShipmentFailedQueueName": "order.shipment-failed",
    "ShipmentFailedRoutingKey": "shipment.failed"
  }
}

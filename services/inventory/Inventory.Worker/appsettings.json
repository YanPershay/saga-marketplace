{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "InventoryDatabase": "Host=localhost;Port=5432;Database=inventory_db;Username=marketplace_user;Password=marketplace_pass"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "marketplace_user",
    "Password": "marketplace_pass",
    "VirtualHost": "marketplace",
    "ExchangeName": "marketplace.domain.events",
    "OrderCreatedQueueName": "inventory.order-created",
    "OrderCreatedRoutingKey": "order.created"
  },
  "RabbitMqConsumer": {
    "MaxRetryCount": 3,
    "RetryDelayMilliseconds": 1000,
    "EnableDeadLetterQueue": true
  }
}


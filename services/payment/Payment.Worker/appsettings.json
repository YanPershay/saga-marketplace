{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "PaymentDatabase": "Host=localhost;Port=5432;Database=payment_db;Username=marketplace_user;Password=marketplace_pass"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "marketplace_user",
    "Password": "marketplace_pass",
    "VirtualHost": "marketplace",
    "ExchangeName": "marketplace.domain.events",
    "PaymentRequestedQueueName": "payment.payment-requested",
    "PaymentRequestedRoutingKey": "payment.requested"
  },
  "PaymentSimulation": {
    "ForceFailure": false
  },
  "RabbitMqConsumer": {
    "MaxRetryCount": 3,
    "RetryDelayMilliseconds": 1000,
    "EnableDeadLetterQueue": true
  }
}
